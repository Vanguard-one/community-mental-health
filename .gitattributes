# 仓库内统一 LF，工作区按平台检出（Windows 上 autocrlf 会还原成 CRLF）
* text=auto eol=lf

# 脚本必须 LF，否则 Git Bash / 容器里执行会报 $'\r': command not found
*.sh    text eol=lf
*.bash  text eol=lf
*.py    text eol=lf
*.mjs   text eol=lf

# Windows 批处理必须 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
